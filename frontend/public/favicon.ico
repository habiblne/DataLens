<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none">
  <defs>
    <linearGradient id="grad" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#34d399"/>
      <stop offset="50%" stop-color="#10b981"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <linearGradient id="accent" x1="8" y1="8" x2="24" y2="24" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#6ee7b7"/>
      <stop offset="100%" stop-color="#38bdf8"/>
    </linearGradient>
  </defs>
  
  <!-- Outer container -->
  <rect width="32" height="32" rx="8" fill="#030712"/>
  <rect x="0.5" y="0.5" width="31" height="31" rx="7.5" stroke="rgba(255,255,255,0.12)"/>

  <!-- Lens Outer Ring -->
  <circle cx="16" cy="16" r="9" stroke="url(#grad)" stroke-width="2" stroke-dasharray="44 8" stroke-linecap="round"/>
  
  <!-- Stylized Data Bars inside lens -->
  <rect x="11" y="15" width="1.5" height="5" rx="0.75" fill="#34d399"/>
  <rect x="14" y="13" width="1.5" height="7" rx="0.75" fill="url(#accent)"/>
  <rect x="17" y="16" width="1.5" height="4" rx="0.75" fill="#38bdf8"/>
  <rect x="20" y="14" width="1.5" height="6" rx="0.75" fill="#818cf8"/>
  
  <!-- Central Focus Node -->
  <circle cx="16" cy="16" r="1.5" fill="#ffffff"/>
</svg>
